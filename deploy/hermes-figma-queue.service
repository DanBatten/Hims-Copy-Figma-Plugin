[Unit]
Description=Hermes Figma Queue
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/hermes-figma-queue
EnvironmentFile=/etc/hermes-figma-queue.env
ExecStart=/usr/bin/node /opt/hermes-figma-queue/server/job-queue.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
